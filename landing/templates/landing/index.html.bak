  font-family: 'Manrope';
  font-style: normal;
  font-weight: 800;
  font-display: swap;
  src: url("0451c499-0a9d-42e5-a69a-c617b4e6d7f1") format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
</style>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; scroll-behavior: smooth; }

    :root {
      --bg: #f4f3ee;
      --bg-card: #ffffff;
      --bg-dark: #0c0c0d;
      --ink: #0c0c0d;
      --ink-2: #3a3a3d;
      --ink-3: #6f6f74;
      --ink-4: #9a9a9f;
      --line: #e6e4dd;
      --line-2: #ebe9e2;
      --brand: #6378ff;
      --brand-2: #4a5cdb;
      --brand-soft: #e9ecff;
      --brand-tint: #f1f3ff;
      --good: #2f6310;
      --good-soft: #e7f0d4;
      --bad: #c33d3c;
      --bad-soft: #fbe5e2;
      --warn: #a07900;
      --warn-soft: #fbf1cf;
    }

    body {
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-feature-settings: "ss01", "cv11";
    }

    a { text-decoration: none; color: inherit; }
    .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; font-feature-settings: "ss01"; }

    /* NAV */
    .nav {
      background: rgba(244, 243, 238, 0.85);
      backdrop-filter: saturate(180%) blur(10px);
      -webkit-backdrop-filter: saturate(180%) blur(10px);
      border-bottom: 1px solid var(--line);
      padding: 0 32px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; }
    .nav-logo-mark {
      width: 28px; height: 28px; border-radius: 8px;
      background: linear-gradient(135deg, #7d8eff 0%, #5567e6 100%);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 1px 0 0 rgba(255,255,255,0.7) inset, 0 6px 14px -4px rgba(99,120,255,0.45);
    }
    .nav-logo-text { font-size: 15px; font-weight: 700; color: var(--ink); letter-spacing: -0.3px; }
    .nav-logo-sub { font-size: 10px; color: var(--ink-4); margin-top: 1px; letter-spacing: 0.3px; }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-link { font-size: 13px; color: var(--ink-2); font-weight: 500; transition: color 0.15s; }
    .nav-link:hover { color: var(--ink); }

    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 18px; border-radius: 10px;
      font-family: inherit; font-size: 13px; font-weight: 600;
      cursor: pointer; border: none;
      transition: transform 0.15s, box-shadow 0.15s, background 0.15s, opacity 0.15s;
      letter-spacing: -0.1px;
    }
    .btn-dark { background: var(--ink); color: #fff; box-shadow: 0 1px 0 0 rgba(255,255,255,0.06) inset, 0 4px 14px -4px rgba(0,0,0,0.25); }
    .btn-dark:hover { transform: translateY(-1px); box-shadow: 0 1px 0 0 rgba(255,255,255,0.08) inset, 0 8px 18px -6px rgba(0,0,0,0.3); }
    .btn-outline { background: var(--bg-card); color: var(--ink); border: 1px solid var(--line); }
    .btn-outline:hover { border-color: #cfccc1; }
    .btn-white { background: #fff; color: var(--ink); box-shadow: 0 4px 14px -4px rgba(255,255,255,0.18); }
    .btn-white:hover { transform: translateY(-1px); }

    .btn-lg { padding: 13px 24px; font-size: 14px; border-radius: 11px; }

    /* SECTION GENERIC */
    .section { padding: 56px 32px; position: relative; }
    .section-inner { max-width: 1080px; margin: 0 auto; }
    .section-head { text-align: center; margin-bottom: 56px; }
    .section-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 500; color: var(--brand-2);
      text-transform: uppercase; letter-spacing: 1.2px;
      margin-bottom: 16px;
    }
    .section-eyebrow::before {
      content: ""; width: 18px; height: 1px; background: var(--brand);
    }
    .section-title {
      font-size: 36px; font-weight: 700; color: var(--ink);
      letter-spacing: -1px; line-height: 1.1;
      max-width: 720px; margin: 0 auto;
      text-wrap: balance;
    }
    .section-sub {
      font-size: 16px; color: var(--ink-3);
      margin-top: 14px; max-width: 560px; margin-left: auto; margin-right: auto;
      text-wrap: pretty;
    }

    /* HERO */
    .hero {
      position: relative;
      padding: 96px 32px 120px;
      overflow: hidden;
      background:
        radial-gradient(900px 500px at 80% -10%, rgba(99,120,255,0.18), transparent 60%),
        radial-gradient(700px 400px at 10% 110%, rgba(99,120,255,0.10), transparent 60%),
        var(--bg);
    }
    .hero::before {
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(to right, rgba(12,12,13,0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(12,12,13,0.035) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 20%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 20%, transparent 75%);
      pointer-events: none;
    }
    .hero-inner {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
      align-items: center;
    }
    .hero-text { max-width: 540px; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 12px 6px 8px;
      border-radius: 100px;
      background: var(--bg-card);
      border: 1px solid var(--line);
      font-size: 12px; font-weight: 500; color: var(--ink-2);
      box-shadow: 0 1px 0 0 rgba(255,255,255,0.7) inset;
      margin-bottom: 28px;
    }
    .hero-badge-pulse {
      position: relative; width: 8px; height: 8px; border-radius: 50%;
      background: var(--good); flex-shrink: 0;
    }
    .hero-badge-pulse::after {
      content: ""; position: absolute; inset: -4px; border-radius: 50%;
      border: 2px solid var(--good);
      animation: pulse 2s ease-out infinite;
    }
    @keyframes pulse {
      0% { transform: scale(0.6); opacity: 0.8; }
      100% { transform: scale(1.6); opacity: 0; }
    }
    .hero h1 {
      font-size: 58px; font-weight: 800;
      color: var(--ink); line-height: 1.02;
      letter-spacing: -2px;
      text-wrap: balance;
    }
    .hero h1 em {
      font-style: normal;
      background: linear-gradient(180deg, #6378ff 20%, #4a5cdb 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      position: relative;
    }
    .hero p {
      font-size: 17px; color: var(--ink-3);
      margin-top: 22px; line-height: 1.6;
      max-width: 480px;
    }
    .hero-btns { display: flex; gap: 10px; margin-top: 32px; flex-wrap: wrap; }
    .hero-meta {
      display: flex; align-items: center; gap: 18px;
      margin-top: 22px;
      font-family: 'Inter', sans-serif;
      font-size: 12px; color: var(--ink-4);
    }
    .hero-meta-item { display: inline-flex; align-items: center; gap: 6px; }
    .hero-meta-item svg { color: var(--good); }

    /* HERO ALERT MOCKUP */
    .hero-mock {
      position: relative;
      perspective: 1200px;
    }
    .alert-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
      box-shadow:
        0 1px 0 0 rgba(255,255,255,0.8) inset,
        0 30px 60px -25px rgba(12,12,13,0.18),
        0 12px 24px -12px rgba(99,120,255,0.18);
      transform: rotate(-1.2deg);
      max-width: 380px;
      margin-left: auto;
    }
    .alert-card::before {
      content: ""; position: absolute; inset: -1px;
      border-radius: inherit; padding: 1px;
      background: linear-gradient(180deg, rgba(99,120,255,0.4), rgba(99,120,255,0));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
              mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      pointer-events: none;
    }
    .alert-head {
      display: flex; align-items: center; gap: 10px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line-2);
      margin-bottom: 14px;
    }
    .alert-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, #7d8eff 0%, #5567e6 100%);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      font-size: 13px; font-weight: 700; color: #fff;
    }
    .alert-name { font-size: 13px; font-weight: 600; color: var(--ink); }
    .alert-time { font-size: 11px; color: var(--ink-4); margin-top: 2px; font-family: 'Inter', sans-serif; }
    .alert-tag {
      margin-left: auto;
      font-size: 10px; font-weight: 600; color: var(--bad);
      background: var(--bad-soft);
      padding: 3px 8px; border-radius: 100px;
      letter-spacing: 0.3px; text-transform: uppercase;
    }
    .alert-body { font-size: 14px; color: var(--ink-2); line-height: 1.55; }
    .alert-body strong { color: var(--ink); font-weight: 700; }
    .alert-domain {
      display: inline-block;
      font-family: 'Inter', sans-serif; font-size: 12px;
      color: var(--brand-2); background: var(--brand-tint);
      padding: 1px 6px; border-radius: 4px;
      border: 1px solid var(--brand-soft);
    }
    .alert-fix {
      margin-top: 14px; padding: 12px 14px;
      background: var(--bg); border: 1px solid var(--line);
      border-radius: 10px;
      font-size: 13px; color: var(--ink-2); line-height: 1.5;
    }
    .alert-fix-label {
      font-family: 'Inter', sans-serif; font-size: 10px;
      color: var(--good); text-transform: uppercase;
      letter-spacing: 0.8px; font-weight: 600;
      margin-bottom: 4px; display: flex; align-items: center; gap: 5px;
    }
    .alert-actions {
      display: flex; align-items: center; gap: 8px; margin-top: 14px;
    }
    .alert-btn {
      flex: 1;
      padding: 8px 12px; border-radius: 8px;
      font-size: 12px; font-weight: 600;
      text-align: center;
      transition: opacity 0.15s, transform 0.15s;
    }
    .alert-btn.primary { background: var(--brand); color: #fff; }
    .alert-btn.ghost { background: var(--bg); color: var(--ink-2); border: 1px solid var(--line); }

    /* Floating mini badges around mockup */
    .float-badge {
      position: absolute;
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 100px;
      padding: 8px 14px 8px 12px;
      font-size: 12px; font-weight: 600; color: var(--ink-2);
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 8px 20px -8px rgba(12,12,13,0.18);
    }
    .float-badge.one {
      top: -16px; left: -20px;
      transform: rotate(-4deg);
    }
    .float-badge.two {
      bottom: -8px; left: 20px;
      transform: rotate(3deg);
    }
    .float-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }
    .float-badge.one .dot { background: var(--warn); }

    /* TRUST STRIP */
    .strip {
      background: var(--bg-card);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 22px 32px;
    }
    .strip-inner {
      max-width: 1080px; margin: 0 auto;
      display: flex; align-items: center; justify-content: center;
      gap: 40px; flex-wrap: wrap;
      font-family: 'Inter', sans-serif;
      font-size: 12px; color: var(--ink-3);
      letter-spacing: 0.3px;
    }
    .strip-item { display: inline-flex; align-items: center; gap: 8px; }
    .strip-item svg { color: var(--brand-2); flex-shrink: 0; }
    .strip-divider { width: 1px; height: 14px; background: var(--line); }

    /* STORY */
    .story { background: var(--bg); }
    .story-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 16px; max-width: 980px; margin: 0 auto;
      position: relative;
    }
    .story-grid::after {
      content: "";
      position: absolute; left: 50%; top: 50%;
      width: 44px; height: 44px;
      transform: translate(-50%, -50%);
      background: var(--bg-card); border: 1px solid var(--line);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700; color: var(--ink-3);
      font-family: 'Inter', sans-serif;
    }
    .story-card {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 32px;
      position: relative;
      transition: transform 0.2s;
    }
    .story-card.bad { background: linear-gradient(180deg, #fdf3f2 0%, #ffffff 60%); }
    .story-card.good { background: linear-gradient(180deg, #f3f8ea 0%, #ffffff 60%); }
    .story-label {
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 500;
      text-transform: uppercase; letter-spacing: 1px;
      margin-bottom: 18px;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .story-label::before { content: ""; width: 6px; height: 6px; border-radius: 50%; }
    .story-label.bad { color: var(--bad); }
    .story-label.bad::before { background: var(--bad); }
    .story-label.good { color: var(--good); }
    .story-label.good::before { background: var(--good); }
    .story-text { font-size: 15.5px; color: var(--ink-2); line-height: 1.65; }
    .story-text strong { color: var(--ink); font-weight: 700; }
    .story-divider {
      position: absolute; left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      width: 36px; height: 36px;
      background: var(--bg-card); border: 1px solid var(--line);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      z-index: 2;
    }

    /* FOR WHO */
    .forwho-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .forwho-card {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 28px;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
      position: relative;
      overflow: hidden;
    }
    .forwho-card::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--brand), transparent 60%);
      opacity: 0; transition: opacity 0.2s;
    }
    .forwho-card:hover { transform: translateY(-2px); border-color: #d8d5c8; box-shadow: 0 12px 24px -16px rgba(12,12,13,0.12); }
    .forwho-card:hover::before { opacity: 1; }
    .forwho-tag {
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 500;
      color: var(--brand-2); text-transform: uppercase;
      letter-spacing: 1px; margin-bottom: 14px;
    }
    .forwho-title { font-size: 17px; font-weight: 700; color: var(--ink); margin-bottom: 10px; letter-spacing: -0.3px; }
    .forwho-desc { font-size: 14px; color: var(--ink-3); line-height: 1.6; }

    /* VS */
    .vs { background: var(--bg-dark); color: #fff; }
    .vs .section-title { color: #fff; }
    .vs .section-sub { color: rgba(255,255,255,0.55); }
    .vs .section-eyebrow { color: #b3bcff; }
    .vs .section-eyebrow::before { background: #b3bcff; }
    .vs-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 18px;
      overflow: hidden;
      background: rgba(255,255,255,0.02);
    }
    .vs-col { padding: 32px 28px; }
    .vs-col:not(:last-child) { border-right: 1px solid rgba(255,255,255,0.08); }
    .vs-col-title {
      font-size: 13px; font-weight: 600;
      color: rgba(255,255,255,0.55);
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      letter-spacing: -0.2px;
    }
    .vs-col.highlight {
      background: linear-gradient(180deg, rgba(99,120,255,0.16) 0%, rgba(99,120,255,0.04) 100%);
      position: relative;
    }
    .vs-col.highlight::before {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(99,120,255,0.6), transparent);
    }
    .vs-col.highlight .vs-col-title { color: #b3bcff; }
    .vs-item {
      font-size: 14px; color: rgba(255,255,255,0.75);
      padding: 8px 0;
      display: flex; align-items: flex-start; gap: 10px;
      line-height: 1.5;
    }
    .vs-icon { flex-shrink: 0; margin-top: 3px; opacity: 0.6; }
    .vs-icon.brand { color: var(--brand); opacity: 1; }
    .vs-col.highlight .vs-item { color: rgba(255,255,255,0.95); }

    /* FEATURES */
    .features {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 28px;
      position: relative;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .feature-card:hover { transform: translateY(-2px); border-color: #d8d5c8; box-shadow: 0 12px 24px -16px rgba(12,12,13,0.12); }
    .feature-icon {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 18px;
      border: 1px solid var(--line-2);
    }
    .feature-title { font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 8px; letter-spacing: -0.2px; }
    .feature-desc { font-size: 14px; color: var(--ink-3); line-height: 1.6; }
    .feature-meta {
      margin-top: 14px; padding-top: 14px;
      border-top: 1px dashed var(--line);
      font-family: 'Inter', sans-serif;
      font-size: 11px; color: var(--ink-4);
      letter-spacing: 0.3px;
      display: flex; align-items: center; gap: 6px;
    }
    .feature-meta-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--brand); }

    /* AUDIT (SEO + GEO) */
    .audit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .audit-card {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 32px;
      display: flex; flex-direction: column;
      position: relative;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .audit-card:hover { transform: translateY(-2px); border-color: #d8d5c8; box-shadow: 0 12px 24px -16px rgba(12,12,13,0.12); }
    .audit-card.brand { background: var(--bg-dark); border-color: var(--bg-dark); color: #fff; }
    .audit-card.brand:hover { border-color: var(--brand); box-shadow: 0 16px 32px -16px rgba(99,120,255,0.4); }
    .audit-badge {
      position: absolute; top: -10px; right: 24px;
      background: var(--brand); color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.6px; text-transform: uppercase;
      padding: 4px 10px; border-radius: 6px;
    }
    .audit-tag {
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 600; color: var(--brand-2);
      text-transform: uppercase; letter-spacing: 1px;
      margin-bottom: 14px;
    }
    .audit-card.brand .audit-tag { color: #b3bcff; }
    .audit-title { font-size: 22px; font-weight: 700; color: var(--ink); letter-spacing: -0.5px; line-height: 1.2; margin-bottom: 12px; }
    .audit-card.brand .audit-title { color: #fff; }
    .audit-desc { font-size: 14.5px; color: var(--ink-3); line-height: 1.6; margin-bottom: 22px; }
    .audit-card.brand .audit-desc { color: rgba(255,255,255,0.62); }
    .audit-list { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-direction: column; gap: 11px; flex: 1; }
    .audit-list li { font-size: 14px; color: var(--ink-2); line-height: 1.5; display: flex; align-items: flex-start; gap: 9px; }
    .audit-card.brand .audit-list li { color: rgba(255,255,255,0.92); }
    .audit-list svg { flex-shrink: 0; color: var(--brand); margin-top: 3px; }
    .audit-card.brand .audit-list svg { color: #b3bcff; }
    .audit-foot {
      margin-top: auto; padding-top: 18px;
      border-top: 1px dashed var(--line);
      font-size: 13px; color: var(--ink-3); line-height: 1.55;
    }
    .audit-card.brand .audit-foot { border-top-color: rgba(255,255,255,0.12); color: rgba(255,255,255,0.62); }
    .audit-foot strong { color: var(--ink); font-weight: 600; }
    .audit-card.brand .audit-foot strong { color: #fff; }
    @media (max-width: 760px) { .audit-grid { grid-template-columns: 1fr; } }

    /* HOW (onboarding) */
    .how { background: var(--bg-card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .how .section-title { max-width: 640px; }
    .steps {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 12px; max-width: 1080px; margin: 0 auto;
      position: relative;
    }
    .steps::before {
      content: "";
      position: absolute; top: 32px; left: 7%; right: 7%; height: 1px;
      background-image: linear-gradient(to right, var(--line) 60%, transparent 60%);
      background-size: 8px 1px;
      z-index: 0;
    }
    .step {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 24px 22px;
      position: relative;
      z-index: 1;
    }
    .step-num {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--bg-card);
      border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Inter', sans-serif;
      font-size: 12px; font-weight: 600; color: var(--brand-2);
      margin-bottom: 18px;
    }
    .step:nth-child(1) .step-num { background: var(--brand); color: #fff; border-color: transparent; box-shadow: 0 4px 10px -3px rgba(99,120,255,0.4); }
    .step-title { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 6px; letter-spacing: -0.2px; }
    .step-desc { font-size: 13.5px; color: var(--ink-3); line-height: 1.55; }
    .step-time {
      margin-top: 14px;
      font-family: 'Inter', sans-serif;
      font-size: 10.5px; color: var(--ink-4);
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .how-foot {
      max-width: 1080px; margin: 32px auto 0;
      text-align: center;
      font-size: 14px; color: var(--ink-3);
    }
    .how-foot strong { color: var(--ink); font-weight: 600; }

    /* CTA */
    .cta {
      background: var(--bg-dark);
      padding: 96px 32px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta::before {
      content: "";
      position: absolute; inset: 0;
      background:
        radial-gradient(700px 400px at 80% 20%, rgba(99,120,255,0.22), transparent 60%),
        radial-gradient(600px 300px at 20% 100%, rgba(99,120,255,0.14), transparent 60%);
    }
    .cta::after {
      content: "";
      position: absolute; inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 80%);
    }
    .cta-inner { position: relative; max-width: 720px; margin: 0 auto; }
    .cta-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 500; color: #b3bcff;
      text-transform: uppercase; letter-spacing: 1.2px;
      margin-bottom: 18px;
    }
    .cta-eyebrow::before { content: ""; width: 18px; height: 1px; background: #b3bcff; }
    .cta h2 { font-size: 44px; font-weight: 800; color: #fff; letter-spacing: -1.2px; line-height: 1.1; text-wrap: balance; }
    .cta p { font-size: 16px; color: rgba(255,255,255,0.6); margin-top: 16px; margin-bottom: 32px; }

    /* FOOTER */
    .footer {
      background: var(--bg-dark);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 28px 32px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px;
    }
    .footer-text {
      font-family: 'Inter', sans-serif;
      font-size: 11px; color: rgba(255,255,255,0.35);
      letter-spacing: 0.3px;
    }
    .footer-link { font-size: 12px; color: rgba(255,255,255,0.5); transition: color 0.15s; }
    .footer-link:hover { color: rgba(255,255,255,0.85); }

    /* RESPONSIVE */
    /* PRICING */
    .pricing { background: var(--bg-card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .pricing-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 16px; max-width: 1180px; margin: 0 auto;
      align-items: stretch;
    }
    .price-card {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 28px 24px;
      display: flex; flex-direction: column;
      position: relative;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .price-card:hover { transform: translateY(-2px); border-color: #d8d5c8; box-shadow: 0 12px 24px -16px rgba(12,12,13,0.12); }
    .price-card.highlight {
      background: var(--bg-dark);
      border-color: var(--bg-dark);
      color: #fff;
    }
    .price-card.highlight:hover { border-color: var(--brand); box-shadow: 0 16px 32px -16px rgba(99,120,255,0.4); }
    .price-badge {
      position: absolute; top: -10px; left: 24px;
      background: var(--brand);
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.6px; text-transform: uppercase;
      padding: 4px 10px; border-radius: 6px;
    }
    .price-tier {
      font-size: 13px; font-weight: 600;
      color: var(--ink-3);
      letter-spacing: 0.3px; text-transform: uppercase;
      margin-bottom: 10px;
    }
    .price-card.highlight .price-tier { color: #b3bcff; }
    .price-amount {
      font-family: 'Fraunces', serif;
      font-size: 36px; font-weight: 500;
      color: var(--ink);
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 4px;
    }
    .price-card.highlight .price-amount { color: #fff; }
    .price-period {
      font-size: 13px; color: var(--ink-4);
      margin-bottom: 22px;
    }
    .price-card.highlight .price-period { color: rgba(255,255,255,0.6); }
    .price-pitch { font-size: 12.5px; color: var(--ink-3); line-height: 1.45; margin: -12px 0 20px; }
    .price-card.highlight .price-pitch { color: rgba(255,255,255,0.62); }
    .price-features {
      list-style: none;
      padding: 0; margin: 0 0 24px;
      display: flex; flex-direction: column; gap: 10px;
      flex: 1;
    }
    .price-features li {
      font-size: 13.5px; color: var(--ink-2);
      line-height: 1.5;
      display: flex; align-items: flex-start; gap: 8px;
      padding-left: 0;
    }
    .price-card.highlight .price-features li { color: rgba(255,255,255,0.92); }
    .price-check {
      flex-shrink: 0;
      color: var(--brand);
      margin-top: 3px;
    }
    .price-card.highlight .price-check { color: #b3bcff; }
    .price-btn {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 6px;
      width: 100%;
      padding: 12px 18px;
      border-radius: 10px;
      font-size: 14px; font-weight: 600;
      background: var(--bg-card);
      color: var(--ink);
      border: 1px solid var(--line);
      transition: all 0.15s;
    }
    .price-btn:hover { border-color: var(--ink); }
    .price-card.highlight .price-btn {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
    }
    .price-card.highlight .price-btn:hover { background: var(--brand-2); border-color: var(--brand-2); }

    @media (max-width: 960px) {
      .hero-inner { grid-template-columns: 1fr; gap: 56px; }
      .hero-text { max-width: 100%; }
      .hero h1 { font-size: 44px; letter-spacing: -1.4px; }
      .alert-card { margin: 0 auto; }
      .float-badge.one { top: -14px; left: 8%; }
      .float-badge.two { bottom: -10px; right: 8%; left: auto; }
      .features, .forwho-grid { grid-template-columns: 1fr 1fr; }
      .pricing-grid { grid-template-columns: 1fr 1fr; }
      .vs-grid { grid-template-columns: 1fr; }
      .vs-col:not(:last-child) { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); }
      .steps { grid-template-columns: 1fr 1fr; }
      .steps::before { display: none; }
    }
    @media (max-width: 640px) {
      .nav { padding: 0 16px; }
      .nav-links { display: none; }
      .nav-logo-sub { display: none; }
      .hero { padding: 56px 16px 80px; }
      .hero h1 { font-size: 34px; letter-spacing: -1px; }
      .hero p { font-size: 15.5px; }
      .hero-btns { flex-direction: column; align-items: stretch; }
      .hero-btns .btn { justify-content: center; }
      .section { padding: 64px 16px; }
      .section-title { font-size: 26px; letter-spacing: -0.6px; }
      .section-sub { font-size: 14.5px; }
      .story-grid { grid-template-columns: 1fr; }
      .story-grid::after { display: none; }
      .features, .forwho-grid { grid-template-columns: 1fr; }
      .pricing-grid { grid-template-columns: 1fr; }
      .steps { grid-template-columns: 1fr; }
      .strip-inner { gap: 16px; flex-direction: column; }
      .strip-divider { display: none; }
      .cta { padding: 64px 16px; }
      .cta h2 { font-size: 30px; letter-spacing: -0.8px; }
      .footer { flex-direction: column; padding: 20px 16px; gap: 10px; text-align: center; }
      .float-badge { display: none; }
    }
  
    /* TRENDS — «Поиск уже изменился» (variant B) */
    .trends {
      padding: 56px 32px;
      background: var(--bg);
    }
    .trends__inner { max-width: 1080px; margin: 0 auto; }
    .trends__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .trends .stat__num {
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 500;
      letter-spacing: -1px;
      line-height: 1;
      font-variant-numeric: lining-nums;
      white-space: nowrap;
      font-size: 52px;
      color: var(--brand-2);
    }
    .trends .stat__caption {
      font-size: 14.5px; line-height: 1.5; color: var(--ink-3);
      text-wrap: pretty;
      margin-bottom: 16px;
    }
    .trends .stat__caption strong { color: var(--ink); font-weight: 700; }
    .trends .stat__source {
      margin-top: auto;
      font-family: 'Inter', sans-serif;
      font-size: 11px; color: var(--ink-4);
      letter-spacing: 0.1px;
      padding-top: 16px;
    }
    .trends .stat {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 24px;
      display: flex; flex-direction: column;
      min-height: 260px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .trends .stat:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -16px rgba(12,12,13,0.12);
    }
    .trends .stat__plaque {
      border-radius: 14px;
      padding: 20px 22px;
      margin-bottom: 18px;
      display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
      background: var(--brand-tint);
      border: 1px solid var(--brand-soft);
    }
    .trends .stat--bad .stat__plaque { background: var(--bad-soft); border-color: #f6d2cd; }
    .trends .stat--good .stat__plaque { background: var(--good-soft); border-color: #d5e3bb; }
    .trends .stat--bad .stat__num { color: var(--bad); }
    .trends .stat--good .stat__num { color: var(--good); }
    .trends .stat__trend {
      flex-shrink: 0;
      font-family: 'Inter', sans-serif;
      font-size: 11px; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.8px;
      padding: 3px 8px; border-radius: 100px;
      background: rgba(255,255,255,0.7);
      color: var(--brand-2);
    }
    .trends .stat--bad .stat__trend { color: var(--bad); }
    .trends .stat--good .stat__trend { color: var(--good); }

    /* TRENDS responsive */
    @media (max-width: 960px) {
      .trends__grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .trends__grid { grid-template-columns: 1fr; }
      .trends { padding: 64px 16px; }
      .trends .stat__num { font-size: 48px; }
    }

  
    /* SCROLL REVEAL (анимация появления) */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity .7s cubic-bezier(.16,.84,.44,1), transform .7s cubic-bezier(.16,.84,.44,1);
      will-change: opacity, transform;
    }
    .reveal.is-visible { opacity: 1; transform: none; }
    /* Reduce Motion: без «движения», только мягкое проявление прозрачности */
    @media (prefers-reduced-motion: reduce) {
      .reveal { transform: none; transition: opacity .7s ease; }
    }
    /* BLOG SECTION */
    .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .blog-card {
      display: flex; flex-direction: column;
      background: var(--bg-card); border: 1px solid var(--line);
      border-radius: 18px; overflow: hidden;
      transition: transform 0.16s, box-shadow 0.16s, border-color 0.16s;
    }
    .blog-card:hover {
      transform: translateY(-3px); border-color: var(--brand-soft);
      box-shadow: 0 28px 50px -30px rgba(99,120,255,0.32);
    }
    .blog-card-cover { aspect-ratio: 16 / 9; background: var(--line-2); overflow: hidden; }
    .blog-card-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .blog-card-cover--empty {
      background: linear-gradient(135deg, var(--brand-tint), var(--brand-soft));
    }
    .blog-card-body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }
    .blog-card-meta {
      display: flex; align-items: center; gap: 8px;
      font-family: 'JetBrains Mono', monospace; font-size: 11.5px;
      color: var(--ink-4); letter-spacing: 0.2px; margin-bottom: 12px;
    }
    .blog-card-meta .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-4); }
    .blog-card-title { font-size: 18px; font-weight: 700; letter-spacing: -0.4px; line-height: 1.25; color: var(--ink); text-wrap: balance; }
    .blog-card-desc { font-size: 14px; color: var(--ink-3); line-height: 1.5; margin-top: 10px; }
    .blog-section-foot { display: flex; justify-content: center; margin-top: 36px; }
    @media (max-width: 880px) { .blog-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <div class="nav-logo">
    <div class="nav-logo-mark" style="background:none;box-shadow:none;padding:0;">
      <img src="/static/img/spiral-icon.svg" width="28" height="28" alt="SEOdyssey">
    </div>
    <div>
      <div class="nav-logo-text">SEOdyssey</div>
      <div class="nav-logo-sub mono">мониторинг сайтов</div>
    </div>
  </div>
  <div class="nav-links">
    <a href="#features" class="nav-link">Возможности</a>
    <a href="#audit" class="nav-link">Аудит</a>
    <a href="/geo-check/" class="nav-link">GEO-проверка</a>
    <a href="#pricing" class="nav-link">Тарифы</a>
    <a href="#how" class="nav-link">Как подключить</a>
    <a href="/blog/" class="nav-link">Блог</a>
    <a href="https://t.me/seodyssey" class="nav-link" target="_blank" rel="noopener">Поддержка</a>
  </div>
  <div style="display:flex;gap:8px;">
    {% if user.is_authenticated %}
    <a href="https://app.seodyssey.ru/" class="btn btn-dark">Перейти в сервис →</a>
    {% else %}
    <a href="https://app.seodyssey.ru/" class="btn btn-dark">Начать →</a>
    {% endif %}
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge">
        <span class="hero-badge-pulse"></span>
        <span>Проверка каждый день&nbsp;в&nbsp;<span class="mono" style="font-weight:600;color:var(--ink);">08:00</span></span>
      </div>
      <h1>О проблемах сайта <em>вы узнаёте первым</em>, а не от&nbsp;клиентов.</h1>
      <p>SEOdyssey следит за вашим сайтом и присылает уведомление в Telegram — с объяснением, что случилось, и готовым решением. Не из упавших заявок и не из отчёта на следующей неделе.</p>
      <div class="hero-btns">
        {% if user.is_authenticated %}
        <a href="https://app.seodyssey.ru/" class="btn btn-dark btn-lg">Перейти в сервис
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
        </a>
        {% else %}
        <a href="https://app.seodyssey.ru/" class="btn btn-dark btn-lg">Начать следить за сайтом
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
        </a>
        {% endif %}
        <a href="#how" class="btn btn-outline btn-lg">Как подключить</a>
      </div>
      <div class="hero-meta">
        <span class="hero-meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          Без скрытых платежей
        </span>
        <span class="hero-meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
          Настройка за 5 минут
        </span>
      </div>
    </div>

    <div class="hero-mock">
      <div class="float-badge one">
        <span class="dot"></span> SSL истекает через 3 дня
      </div>
      <div class="alert-card">
        <div class="alert-head">
          <div class="alert-avatar">SE</div>
          <div>
            <div class="alert-name">SEOdyssey · уведомление</div>
            <div class="alert-time">сегодня, 08:02</div>
          </div>
          <div class="alert-tag">срочно</div>
        </div>
        <div class="alert-body">
          На сайте <span class="alert-domain">shop.example.ru</span> через&nbsp;<strong>3&nbsp;дня</strong> истекает SSL-сертификат. После этого браузеры начнут показывать предупреждение, и заявки перестанут приходить.
        </div>
        <div class="alert-fix">
          <div class="alert-fix-label">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
            что делать
          </div>
          Свяжитесь с хостингом или продлите Let's&nbsp;Encrypt: <span class="mono" style="color:var(--brand-2);">certbot renew</span>. Готовое сообщение для разработчика — внутри.
        </div>
        <div class="alert-actions">
          <a class="alert-btn primary">Открыть инструкцию</a>
          <a class="alert-btn ghost">Переслать</a>
        </div>
      </div>
      <div class="float-badge two">
        <span class="dot"></span> Алерт в Telegram · 08:02
      </div>
    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<div class="strip">
  <div class="strip-inner">
    <span class="strip-item">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      HTTP · SSL · DNS · домен
    </span>
    <span class="strip-divider"></span>
    <span class="strip-item">
