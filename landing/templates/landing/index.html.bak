<!-- HOW IT WORKS — pure onboarding -->
<section class="how section" id="how">
  <div class="section-inner">
    <div class="section-head">
      <div class="section-eyebrow">Подключение · 4 шага</div>
      <h2 class="section-title">Запуск за 5 минут — без кода и&nbsp;разработчика</h2>
      <p class="section-sub">Всё что нужно сделать вручную. Дальше сервис работает сам.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <div class="step-title">Зарегистрируйтесь</div>
        <div class="step-desc">Создайте аккаунт — обычная быстрая регистрация, без сложных форм и настроек.</div>
        <div class="step-time">≈ 1 минута</div>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <div class="step-title">Добавьте домен сайта</div>
        <div class="step-desc">Просто введите адрес. Никаких скриптов, кодов вставки или DNS-настроек.</div>
        <div class="step-time">≈ 30 секунд</div>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <div class="step-title">Подключите источники</div>
        <div class="step-desc">Опционально: Яндекс Метрика и Вебмастер для данных по трафику и индексации.</div>
        <div class="step-time">≈ 2 минуты</div>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <div class="step-title">Готово — ждите уведомлений</div>
        <div class="step-desc">Сервис следит за сайтом и присылает сообщение в Telegram, если что-то не так.</div>
        <div class="step-time">далее — без вас</div>
      </div>
    </div>
    <div class="how-foot">
      Первая проверка пройдёт сразу после добавления сайта. Дальше сервис работает сам.
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="pricing section" id="pricing">
  <div class="section-inner">
    <div class="section-head">
      <div class="section-eyebrow">Тарифы</div>
      <h2 class="section-title">Простые цены —&nbsp;без скрытых платежей</h2>
      <p class="section-sub">Начните бесплатно. Платные тарифы добавляют проекты, больше AI-проверок и GEO-аудит.</p>
    </div>
    <div class="pricing-grid">
      {% for plan in plans %}
      <div class="price-card{% if plan.slug == 'pro' %} highlight{% endif %}">
        {% if plan.slug == 'pro' %}<div class="price-badge">Популярный</div>{% endif %}
        <div class="price-tier">{{ plan.name }}</div>
        <div class="price-amount">{{ plan.price_monthly|thousands }}&nbsp;₽</div>
        <div class="price-period">{% if plan.price_monthly %}в&nbsp;месяц{% else %}навсегда{% endif %}</div>
        <div class="price-pitch">{% if plan.slug == 'free' %}Попробовать сервис на одном проекте{% elif plan.slug == 'start' %}Для одного сайта, который нельзя терять{% elif plan.slug == 'pro' %}Для тех, кто ведёт несколько проектов{% elif plan.slug == 'agency' %}Для агентств и большого портфеля сайтов{% endif %}</div>
        <ul class="price-features">
          <li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Проектов: {{ plan.max_projects }}</li>
          <li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Автоаудит: {{ plan.get_audit_frequency_display }}</li>
          <li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>AI-проверок в месяц: {{ plan.ai_limit }}</li>
          {% if plan.slug == 'free' %}<li style="color:var(--ink-4);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:3px;color:var(--ink-4);"><path d="M5 12h14"></path></svg>GEO-аудит — на платных тарифах</li>{% else %}<li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>GEO-аудит видимости в ИИ</li>{% endif %}
          <li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Интеграций на сайт: {% if plan.max_integrations is None %}без лимита{% else %}{{ plan.max_integrations }}{% endif %}</li>
          {% if plan.telegram_alerts %}<li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>Telegram-алерты</li>{% endif %}
          <li><svg class="price-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>История: {% if plan.history_days is None %}без лимита{% else %}{{ plan.history_days }} дн.{% endif %}</li>
        </ul>
        <a href="https://app.seodyssey.ru/" class="price-btn">{% if plan.price_monthly %}Выбрать {{ plan.name }}{% else %}Начать бесплатно{% endif %}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- BLOG -->
{% if latest_posts %}
<section class="blog-section section" id="blog">
  <div class="section-inner">
    <div class="section-head">
      <div class="section-eyebrow">Блог</div>
      <h2 class="section-title">Разборы, кейсы и статьи</h2>
      <p class="section-sub">Как сайты попадают в ответы ChatGPT, Яндекс.Нейро, AI Overviews — и как этим управлять.</p>
    </div>
    <div class="blog-grid">
      {% for post in latest_posts %}
      <a class="blog-card" href="/blog/{{ post.slug }}/">
        {% if post.cover %}
          <div class="blog-card-cover"><img src="{{ post.cover.url }}" alt="{{ post.title }}" loading="lazy"></div>
        {% else %}
          <div class="blog-card-cover blog-card-cover--empty"></div>
        {% endif %}
        <div class="blog-card-body">
          <div class="blog-card-meta">
            {% if post.published_at %}<span>{{ post.published_at }}</span>{% endif %}
            {% if post.read_time %}<span class="dot"></span><span>{{ post.read_time }} мин</span>{% endif %}
          </div>
          <div class="blog-card-title">{{ post.title }}</div>
          {% if post.description %}<div class="blog-card-desc">{{ post.description }}</div>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
    <div class="blog-section-foot">
      <a href="/blog/" class="btn btn-outline">Все статьи
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
{% endif %}

<!-- CTA -->
<section class="cta">
  <div class="cta-inner">
    <div class="cta-eyebrow">Готовы начать?</div>
    <h2>Сайт под контролем — прямо сейчас</h2>
    <p>Настройка за 5 минут. Первое уведомление — в Telegram.</p>
    {% if user.is_authenticated %}
    <a href="https://app.seodyssey.ru/" class="btn btn-white btn-lg">Перейти в сервис
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
    </a>
    {% else %}
    <a href="https://app.seodyssey.ru/" class="btn btn-white btn-lg">Начать следить за сайтом
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
    </a>
    {% endif %}
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-text">© 2026 SEOdyssey · мониторинг сайтов</div>
  <div style="display:flex;gap:20px;align-items:center;">
    <a href="/blog/" class="footer-link">Блог</a>
    <a href="/requisites/" class="footer-link">Реквизиты</a>
    <a href="/offer/" class="footer-link">Оферта</a>
    <a href="https://t.me/seodyssey" class="footer-link" target="_blank" rel="noopener">Написать автору <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-left:1px"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
  </div>
</footer>

<!-- SCROLL REVEAL -->
<script>
(function () {
  // Уважаем настройку «уменьшить движение» и старые браузеры — там просто без анимации
  // Без IntersectionObserver (очень старые браузеры) — просто показываем контент как есть
  if (!('IntersectionObserver' in window)) return;

  var sel = '.section-head, .hero-text, .hero-mock, .strip-inner, .story-card,' +
            '.forwho-card, .feature-card, .audit-card, .price-card,' +
            '.trends .stat, .vs-col, .step';
  var els = Array.prototype.slice.call(document.querySelectorAll(sel));

  // помечаем и задаём каскад внутри каждого родителя
  var counters = new WeakMap();
  els.forEach(function (el) {
    el.classList.add('reveal');
    var p = el.parentNode;
    var i = counters.get(p) || 0;
    el.style.transitionDelay = Math.min(i * 70, 350) + 'ms';
    counters.set(p, i + 1);
  });

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

  els.forEach(function (el) { io.observe(el); });
})();
</script>


<!-- COUNT-UP (накрутка цифр в блоке трендов) -->
<script>
(function () {
  if (!('IntersectionObserver' in window)) return;

  var nums = Array.prototype.slice.call(document.querySelectorAll('.trends .stat__num'));
  if (!nums.length) return;

  function parse(txt) {
    var m = txt.match(/(\D*)(\d+)(\D*)/);   // префикс · число · суффикс
    return m ? { pre: m[1], val: parseInt(m[2], 10), suf: m[3] } : null;
  }

  function run(el) {
    var p = parse(el.textContent);
    if (!p) return;
    var dur = 1100, start = null;
    function ease(t) { return 1 - Math.pow(1 - t, 3); }   // easeOutCubic
    function step(ts) {
      if (start === null) start = ts;
      var t = Math.min((ts - start) / dur, 1);
      el.textContent = p.pre + Math.round(ease(t) * p.val) + p.suf;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = p.pre + p.val + p.suf;   // гарантируем точный финал
    }
    requestAnimationFrame(step);
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { run(e.target); io.unobserve(e.target); }
    });
  }, { threshold: 0.4 });

  nums.forEach(function (el) { io.observe(el); });
})();
</script>

</body>
</html>